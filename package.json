{
  "name": "actual-play-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An index of actual-play TTRPG credits, by person. Git-as-database, static-first.",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "dev": "astro dev",
    "build": "npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview",
    "filmography": "tsx scripts/filmography.ts",
    "collect": "tsx scripts/collect.ts",
    "audit": "tsx scripts/audit.ts",
    "discover:youtube": "tsx scripts/discover-youtube.ts",
    "import:yt-shows": "tsx scripts/import-yt-shows.ts",
    "sweep:youtube": "tsx scripts/sweep-youtube.ts",
    "fetch:images": "tsx scripts/fetch-images.ts",
    "import:archive": "tsx scripts/import-archive.ts",
    "find:wikis": "tsx scripts/find-wikis.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "astro": "^5.1.1",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}

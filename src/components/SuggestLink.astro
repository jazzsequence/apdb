---
/**
 * "This has no link — here is exactly how to add one."
 *
 * Written as a pull request path rather than an issue, because an issue about
 * a missing URL is the worst possible shape for the work: someone reports a
 * link, someone else opens the right file, finds the right season, and types
 * it in by hand. The change itself is two lines of YAML.
 *
 * GitHub's editor cannot be pre-filled — only its new-file form takes a
 * `value` parameter, and these files already exist. So the next best thing is
 * to show the exact snippet to paste and open the file at the same click. The
 * edit becomes a fork, a branch, a commit and a pull request without the
 * contributor doing any of that themselves, and CI validates it on arrival.
 */
export const REPO = 'jazzsequence/apdb';

interface Props {
  /** Repo-relative path of the file to edit. */
  file: string;
  /** What is missing a link, in words. */
  what: string;
  /** The YAML to paste, already indented for where it goes. */
  snippet: string;
  /** Where in the file it belongs. */
  hint: string;
}

const { file, what, snippet, hint } = Astro.props;
const editUrl = `https://github.com/${REPO}/edit/main/${file}`;
---

<div class="suggest-link">
  <p class="billing">
    <strong>No direct link for {what}.</strong> If you know where to watch it,
    this is a two-line change — {hint}
  </p>
  <pre class="yaml-snippet"><code>{snippet}</code></pre>
  <p class="billing">
    <a class="watch watch--watch" href={editUrl} rel="nofollow noopener">Edit
      <code>{file}</code></a>
    — GitHub turns the edit into a pull request for you.
  </p>
</div>

<style>
  .suggest-link {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
    margin: 1rem 0;
  }
  .suggest-link .billing {
    margin: 0 0 0.5rem;
  }
  .suggest-link .billing:last-child {
    margin: 0.6rem 0 0;
  }
  .yaml-snippet {
    background: var(--sunk);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
    margin: 0;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre;
  }
  .suggest-link code {
    font-size: 0.82em;
  }
</style>

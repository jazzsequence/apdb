---
import type { FilmographyGroup } from '../lib/derive';

interface Props {
  groups: FilmographyGroup[];
}

const { groups } = Astro.props;
const base = import.meta.env.BASE_URL;

function yearRange(group: FilmographyGroup): string {
  const { earliestYear: from, latestYear: to } = group;
  if (!from && !to) return '';
  if (from && to && from.slice(0, 4) !== to.slice(0, 4)) {
    return `${from.slice(0, 4)}–${to.slice(0, 4)}`;
  }
  return (to ?? from ?? '').slice(0, 4);
}
---

{
  groups.map((group) => (
    <article class="film-show">
      <header>
        {group.show.image && (
          <img
            class="poster"
            src={group.show.image.url}
            alt=""
            loading="lazy"
            decoding="async" referrerpolicy="no-referrer"
          />
        )}
        <h3>
          <a href={`${base}shows/${group.show.id}/`}>{group.show.title}</a>
        </h3>
        <span class="years">{yearRange(group)}</span>
        <span class="channel">
          {group.channels.map((c) => `${c.name} · ${c.type}`).join(', ')} · {group.show.format}
        </span>
      </header>

      <table class="credit-table">
        <thead>
          <tr>
            <th scope="col">Season</th>
            <th scope="col">Role</th>
            <th scope="col">Character</th>
            <th scope="col">System</th>
            <th scope="col">Provenance</th>
          </tr>
        </thead>
        <tbody>
          {group.credits.map(({ credit, season, game, alias, creditedUnderFormerName, tier, corroboration }) => (
            <>
              <tr>
                <td class="c-where" data-label="Season">
                  {season
                    ? `Season ${season.ordinal}${season.title ? ` — ${season.title}` : ''}`
                    : 'Show-level credit'}
                  {credit.episode && <span class="episode">{credit.episode}</span>}
                </td>

                <td class="c-role" data-label="Role">{credit.role}</td>

                <td class="c-char" data-label="Character">
                  {credit.character ?? ''}
                  {alias ? (
                    creditedUnderFormerName && (
                      <>
                        {' '}
                        <span class="tag tag--former" title={`Credited as ${alias.name}`}>
                          as {alias.name}
                        </span>
                      </>
                    )
                  ) : (
                    <span
                      class="unbilled"
                      title="Nobody has established which name was on the billing for this credit."
                    >
                      billing unknown
                    </span>
                  )}
                </td>

                <td class="c-system" data-label="System">
                  {game && (
                    <>
                      {game.name}
                      <span class="edition">{game.edition}</span>
                    </>
                  )}
                </td>

                <td class="c-prov" data-label="Provenance">
                  <span
                    class={`tag tier tier--${tier.strength}`}
                    title={[
                      tier.description,
                      ...credit.sources
                        .filter((s) => s.attested_by)
                        .map((s) => `Attested by ${s.attested_by}.`),
                    ].join(' ')}
                  >
                    {tier.label}
                  </span>
                  {corroboration.status === 'corroborated' ? (
                    <span
                      class="tag tag--corroborated"
                      title={`${corroboration.independent} independent sources agree.`}
                    >
                      ×{corroboration.independent}
                    </span>
                  ) : (
                    <span
                      class="tag tag--flag"
                      title="One source so far. A second independent account would corroborate it."
                    >
                      single
                    </span>
                  )}
                  {credit.sources.map((source) =>
                    source.url ? (
                      <a href={source.url} rel="nofollow noopener" title={source.note}>
                        source
                      </a>
                    ) : null,
                  )}
                </td>
              </tr>
              {credit.note && (
                <tr class="row-note">
                  <td colspan="5">{credit.note}</td>
                </tr>
              )}
            </>
          ))}
        </tbody>
      </table>
    </article>
  ))
}

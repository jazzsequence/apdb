---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Marks this page's main content as a Pagefind search body. Only entity
   * pages (people, shows) are indexed — index and listing pages would just be
   * duplicate noise in the results.
   */
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og-image.png`, Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Fandom serves a 404 for any image request carrying a Referer header —
      standard hotlink protection — which silently broke every wiki-sourced
      poster and portrait on the site. Suppressing the referrer fixes it, and
      is the more privacy-preserving default for outbound links anyway.
    */}
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    {/* Slack, Discord, X, etc. all read these for link unfurls — without
        them a shared link falls back to a screenshot-less text card. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Actual Play Database" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href={base}>Actual Play Database</a>
        <button
          type="button"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label="Menu"
        >
          <span></span><span></span><span></span>
        </button>
        <nav id="nav-links" class="nav-links">
          <a href={`${base}people/`}>People</a>
          <a href={`${base}shows/`}>Shows</a>
          <a href={`${base}channels/`}>Channels</a>
          <a href={`${base}search/`}>Search</a>
          <a href={`${base}random/`}>Surprise me</a>
          <a href={`${base}submit/`}>Submit</a>
        </nav>
      </div>
    </header>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('nav-links');
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
        };
        toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
        nav.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }
    </script>

    <main class="wrap" data-pagefind-body={indexable ? '' : undefined}>
      <slot />

      <footer class="site">
        <p>
          Community-curated. Every entry is a file in git; every correction is
          a pull request. <a href={`${base}about/`}>How credits are sourced and verified →</a>
        </p>
      </footer>
    </main>
  </body>
</html>

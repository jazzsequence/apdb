---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Marks this page's main content as a Pagefind search body. Only entity
   * pages (people, shows) are indexed — index and listing pages would just be
   * duplicate noise in the results.
   */
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href={base}>Actual Play Database</a>
        <a href={`${base}people/`}>People</a>
        <a href={`${base}shows/`}>Shows</a>
        <a href={`${base}search/`}>Search</a>
      </div>
    </header>

    <main class="wrap" data-pagefind-body={indexable ? '' : undefined}>
      <slot />

      <footer class="site">
        <p>
          Community-curated. Every entry is a file in git; every correction is a
          pull request.
        </p>
        <p>
          Every credit is tagged with its source tier, ranked by how close the
          source was to the thing happening:
          <span class="tag tier tier--strong">official</span>
          <span class="tag tier tier--strong">recording</span>
          <span class="tag tier tier--strong">participant</span>
          <span class="tag tier tier--medium">saw it firsthand</span>
          <span class="tag tier tier--medium">reference work</span>
          <span class="tag tier tier--medium">community</span>
          <span class="tag tier tier--weak">inferred</span>.
        </p>
        <p>
          Someone who watched the episode outranks a published summary of it —
          they were closer to the fact. Unlike Wikipedia, we admit unpublished
          firsthand accounts, because for much of the indie long tail a listener
          is the only source that will ever exist. Whether a stranger can go and
          check is a separate question, marked
          <span class="tag tag--flag">uncorroborated</span>.
        </p>
      </footer>
    </main>
  </body>
</html>

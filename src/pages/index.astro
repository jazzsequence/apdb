---
import Base from '../layouts/Base.astro';
import { getDb } from '../lib/db';
import trendingData from '../data/trending.json';

const db = await getDb();
const base = import.meta.env.BASE_URL;

const creditCount = db.people.reduce((sum, p) => sum + p.credits.length, 0);

// Most credited. Ties broken by number of distinct shows, so someone with 20
// credits across 9 shows ranks above someone with 20 on one long-running one.
const mostCredited = [...db.people]
  .map((p) => ({ p, shows: new Set(p.credits.map((c) => c.show)).size }))
  .sort((a, b) => b.p.credits.length - a.p.credits.length || b.shows - a.shows)
  .slice(0, 18)
  .map(({ p, shows }) => ({
    id: p.id,
    name: p.canonical_name,
    credits: p.credits.length,
    shows,
    image: p.image?.url ?? null,
  }));

/*
 * The daily pick pool. Shows with art and at least one credit — a poster row
 * of blank plates and empty pages is not a good front door.
 *
 * The whole pool ships to the client so the selection can be made against the
 * reader's own date rather than the date of the last build. A static site is
 * built when someone pushes, which might be weeks apart; "resets every day"
 * has to mean the reader's day.
 */
const pool = db.shows
  .filter((s) => s.image && db.castFor(s).length > 0)
  .map((s) => ({
    id: s.id,
    title: s.title,
    image: s.image!.url,
    by: db.channelsFor(s).map((c) => c.name).join(', '),
    cast: db.castFor(s).length,
  }));

/*
 * Trending is computed offline by `npm run fetch:trending` — see that script
 * for why "trending" means lifetime view count, not a real trend signal, and
 * why it only covers the 122 of 284 shows that link a YouTube playlist. The
 * snapshot is joined against current show data here so art and channel names
 * stay live even between refreshes.
 */
const trending = trendingData.shows
  .map((t) => {
    const show = db.shows.find((s) => s.id === t.id);
    if (!show) return null;
    return {
      id: show.id,
      title: show.title,
      image: show.image?.url ?? null,
      by: db.channelsFor(show).map((c) => c.name).join(', '),
      views: t.views,
    };
  })
  .filter((t): t is NonNullable<typeof t> => t !== null)
  .slice(0, 10);

function formatViews(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M views`;
  if (n >= 1_000) return `${(n / 1_000).toFixed(0)}K views`;
  return `${n} views`;
}
---

<Base
  title="Actual Play Database"
  description="An index of actual play TTRPG credits, by person. Every show, every season, every guest spot — including the indie long tail."
>
  <h1>Actual Play Database</h1>
  <p class="lede">
    Existing actual-play indexes are organised by show. This one is organised by
    <strong>person</strong> — every credit across every show and season, including
    the one-off guest spots on small indie campaigns that other aggregators drop.
  </p>

  <p class="billing">
    Indexing <strong>{creditCount.toLocaleString()}</strong> credits ·
    <strong>{db.people.length}</strong> people · <strong>{db.shows.length}</strong> shows
    · <strong>{db.channels.length}</strong> channels
    · <a href={`${base}random/`}>surprise me →</a>
  </p>

  <h2>Most credited</h2>
  <ul class="rail" id="most-credited">
    {
      mostCredited.map((p) => (
        <li>
          <a href={`${base}people/${p.id}/`}>
            {p.image ? (
              <img class="face" src={p.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            ) : (
              <span class="face face--blank" aria-hidden="true">{p.name.charAt(0)}</span>
            )}
            <span class="rail-name">{p.name}</span>
            <span class="rail-meta">{p.credits} credits · {p.shows} shows</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    trending.length > 0 && (
      <>
        <h2>Trending on YouTube</h2>
        <p class="billing">
          Ranked by lifetime view count on each show's playlist — only the {trendingData.eligibleShows} of{' '}
          {trendingData.totalShows} shows that link one can appear here, and this is total views, not a
          real trend signal. Snapshot from {new Date(trendingData.generatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.
        </p>
        <ul class="poster-rail">
          {trending.map((t) => (
            <li>
              <a href={`${base}shows/${t.id}/`}>
                <div class="art">
                  {t.image ? (
                    <img src={t.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="plate" aria-hidden="true">{t.title.charAt(0)}</span>
                  )}
                </div>
                <h3>{t.title}</h3>
                <p>{t.by} · {formatViews(t.views)}</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>Today's picks</h2>
  <p class="billing">Six shows, chosen by the date. Different tomorrow.</p>
  <ul class="poster-rail" id="daily"></ul>

  <noscript>
    <p class="billing">
      The daily picks need JavaScript to follow your date.
      <a href={`${base}shows/`}>Browse all shows instead →</a>
    </p>
  </noscript>
</Base>

<script define:vars={{ pool, base }}>
  /*
   * Deterministic per-day shuffle. Everyone loading the page on the same day
   * sees the same six shows, and nobody needs a server to arrange that.
   */
  function seededRandom(seed) {
    let t = seed + 0x6d2b79f5;
    return function () {
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function pickForToday(items, n) {
    const now = new Date();
    const seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
    const rand = seededRandom(seed);
    const copy = [...items];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(rand() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy.slice(0, n);
  }

  const daily = document.getElementById('daily');
  if (daily) {
    daily.innerHTML = pickForToday(pool, 6)
      .map(
        (s) => `
      <li>
        <a href="${base}shows/${s.id}/">
          <div class="art"><img src="${s.image}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>
          <h3>${s.title.replace(/</g, '&lt;')}</h3>
          <p>${s.by.replace(/</g, '&lt;')} · ${s.cast} credited</p>
        </a>
      </li>`,
      )
      .join('');
  }
</script>

---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';
import { seasonGameIds } from '../../lib/schema';
import EntityActions from '../../components/EntityActions.astro';
import WatchLinks from '../../components/WatchLinks.astro';
import { describedLinks } from '../../lib/links';

export async function getStaticPaths() {
  const db = await getDb();
  return db.shows.map((show) => ({
    params: { id: show.id },
    props: {
      show,
      channels: db.channelsFor(show),
      cast: db.castFor(show),
      games: db.gamesFor(show),
    },
  }));
}

const { show, channels, cast, games } = Astro.props;

// A wiki page tells you about a show; it does not let you watch one.
const canWatch = describedLinks(show.links).some((l) => l.kind === 'watch' || l.kind === 'listen');
const base = import.meta.env.BASE_URL;

// Cast is derived by inverting credits — never stored on the show.
const bySeason = new Map<number | 'show', typeof cast>();
for (const member of cast) {
  const key = member.credit.season ?? ('show' as const);
  bySeason.set(key, [...(bySeason.get(key) ?? []), member]);
}
const seasonKeys = [...bySeason.keys()].sort((a, b) => {
  if (a === 'show') return 1;
  if (b === 'show') return -1;
  return a - b;
});

// schema.org has a dedicated PodcastSeries type; everything else (video,
// stream, hybrid) is credited work with no broadcast-TV connotation to
// misrepresent, so CreativeWorkSeries — the type both TVSeries and
// PodcastSeries themselves specialize — is the honest fit rather than
// reaching for TVSeries on a YouTube show.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': show.format === 'podcast' ? 'PodcastSeries' : 'CreativeWorkSeries',
  name: show.title,
  url: new URL(`${base}shows/${show.id}/`, Astro.site).toString(),
  ...(show.description && { description: show.description }),
  ...(show.image && { image: show.image.url }),
  ...(channels.length > 0 && {
    productionCompany: channels.map((c) => ({ '@type': 'Organization', name: c.name })),
  }),
  sameAs: Object.values(show.links).filter((v): v is string => Boolean(v)),
};
---

<Base
  indexable
  title={`${show.title} — Actual Play Database`}
  description={show.description ?? `Cast, seasons and systems for ${show.title}.`}
  jsonLd={jsonLd}
>
  <div class="portrait-row">
    {show.image && (
      <figure class="keyart">
        <img src={show.image.url} alt={show.image.depicts ?? show.title} loading="lazy" referrerpolicy="no-referrer" />
        <figcaption>
          {show.image.attribution}{' '}
          <a href={show.image.source} rel="nofollow noopener">source</a>
        </figcaption>
      </figure>
    )}
    <div>
      <h1>{show.title}</h1>

  <p class="billing">
    {channels.map((c, i) => (<>{i > 0 && ', '}<a href={`${base}channels/${c.id}/`}>{c.name}</a>{` (${c.type})`}</>))} ·
    <strong>{show.format}</strong> · {show.status} ·
    {games.map((g) => `${g.name} ${g.edition}`).join(', ')}
  </p>

      <WatchLinks
        links={show.links}
        emptyNote="No link recorded for this show yet — a correction with one would be welcome."
      />
    </div>
  </div>

  {show.description && <p class="lede">{show.description}</p>}

  <h2>Seasons</h2>
  <ul class="card-list">
    {
      show.seasons.map((season) => {
        const seasonGames = seasonGameIds(season)
          .map((id) => games.find((g) => g.id === id))
          .filter((g) => g !== undefined);
        const dates = [season.started, season.ended].filter(Boolean).join(' – ');
        return (
          <li class="card">
            <h3>
              <a href={`${base}shows/${show.id}/${season.ordinal}/`}>
                Season {season.ordinal}
                {season.title ? ` — ${season.title}` : ''}
              </a>
            </h3>
            <p>
              {seasonGames.length > 0
                ? seasonGames.map((g) => `${g.name} · ${g.edition}`).join(' / ')
                : seasonGameIds(season).join(', ')}
              {dates ? ` · ${dates}` : ''}
              {season.episode_count ? ` · ${season.episode_count} episodes` : ''}
            </p>
            {season.description && <p>{season.description}</p>}
          </li>
        );
      })
    }
  </ul>

  <h2>Cast &amp; crew</h2>
  <p class="billing">Derived from credits recorded on each person's page.</p>

  {
    cast.length === 0 ? (
      <p class="lede">No credits reference this show yet.</p>
    ) : (
      seasonKeys.map((key) => (
        <article class="film-show">
          <header>
            <h3>
              {key === 'show'
                ? 'Show-level'
                : (
                    <a href={`${base}shows/${show.id}/${key}/`}>
                      {`Season ${key}${show.seasons.find((s) => s.ordinal === key)?.title ? ` — ${show.seasons.find((s) => s.ordinal === key)!.title}` : ''}`}
                    </a>
                  )}
            </h3>
          </header>
          {/*
            Faces, not rows. On a show page the question is "who is in this",
            and a portrait answers it faster than a name — especially for the
            guest spots this index exists to record.
          */}
          <ul class="cast-grid">
            {bySeason.get(key)!.map(({ person, credit, alias }) => (
              <li>
                <a href={`${base}people/${person.id}/`}>
                  {person.image ? (
                    <img
                      class="cast-face"
                      src={person.image.url}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <span class="cast-face cast-face--blank" aria-hidden="true">
                      {person.canonical_name.slice(0, 1)}
                    </span>
                  )}
                  <span class="cast-name">
                    {alias?.name ?? person.canonical_name}
                    {alias && alias.name !== person.canonical_name && (
                      <em> — now {person.canonical_name}</em>
                    )}
                    {!alias && <em> — billing unknown</em>}
                  </span>
                  <span class="cast-role">
                    {credit.role}
                    {credit.character ? ` as ${credit.character}` : ''}
                    {credit.episode ? ` · ${credit.episode}` : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    )
  }
  <EntityActions
    kind="show"
    snippet={canWatch ? undefined : 'links:\n  website: https://www.youtube.com/playlist?list=…'}
    snippetHint={canWatch ? undefined : "There is nowhere to watch this recorded — only a wiki or a home page. Add a playlist, feed or archive page to the show's links:"}
    file={`data/shows/${show.id}.yml`}
    name={show.title}
    path={`/shows/${show.id}/`}
    hasImage={Boolean(show.image)}
    caveat="systems, seasons and whether it belongs here at all have all been wrong before"
  />
</Base>

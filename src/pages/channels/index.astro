---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';
import { primaryLink } from '../../lib/links';

const db = await getDb();
const base = import.meta.env.BASE_URL;

const rows = db.channels
  .map((channel) => ({
    channel,
    shows: db.shows.filter((s) => s.channels.includes(channel.id)),
    // Their own home — the card itself goes to our page for them.
    home: primaryLink(channel.links),
  }))
  .sort((a, b) => b.shows.length - a.shows.length || a.channel.name.localeCompare(b.channel.name));
---

<Base
  title="Channels — Actual Play Database"
  description="Every producing entity indexed: networks, indie studios and solo creators."
>
  <h1>Channels</h1>
  <p class="lede">
    Who makes the shows. Networks, independent studios and solo creators are all
    first-class here — the small ones are where the long tail lives.
  </p>

  <ul class="card-list">
    {
      rows.map(({ channel, shows, home }) => (
        <li>
          <a href={`${base}channels/${channel.id}/`}>
            <div class="card">
              <h3>{channel.name}</h3>
              <p>
                {channel.type} · {shows.length} show{shows.length === 1 ? '' : 's'}
              </p>
            </div>
          </a>
          {home && (
            <a class="card-watch" href={home.url} rel="nofollow noopener">{home.label} ↗</a>
          )}
        </li>
      ))
    }
  </ul>
</Base>

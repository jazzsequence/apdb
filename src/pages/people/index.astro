---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';

const db = await getDb();
const base = import.meta.env.BASE_URL;
---

<Base title="People — Actual Play Database" description="Every indexed performer, GM and crew member.">
  <h1>People</h1>
  <p class="lede">Listed by sort name. Former names are searchable and resolve here.</p>

  <ul class="cast-grid">
    {
      db.people.map((person) => {
        const others = person.aliases.filter((a) => a.name !== person.canonical_name);
        const shows = new Set(person.credits.map((c) => c.show));
        return (
          <li>
            <a href={`${base}people/${person.id}/`}>
              {person.image ? (
                <img
                  class="cast-face"
                  src={person.image.url}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              ) : (
                <span class="cast-face cast-face--blank" aria-hidden="true">
                  {person.sort_name.slice(0, 1)}
                </span>
              )}
              <span class="cast-name">{person.sort_name}</span>
              <span class="cast-role">
                {person.credits.length} credits across {shows.size} shows
                {others.length > 0 && (
                  <> · formerly {others.map((a) => a.name).join(', ')}</>
                )}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
